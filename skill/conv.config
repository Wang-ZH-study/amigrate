;; conv.config — smic18ee → PDK_13mmrf（1.8V 方案 B：n33/p33）
;;
;; 用法：load("abConvertComponentParams.il"); abConvertComponentParamsHier("conv.config")
;;
;; 2026-11-25 决策 B：保 1.8V，目标器件用 3.3V IO 的 n33/p33（不是 1.2V core 的 n12/p12）。
;; 器件名/CDF 已在 VM 确认：n33、p33 存在；参数名 w/l/m/fingers（无 nf）。
;; 电阻/电容映射待 05.2 之后确认（先只放 MOS，避免把未验证的映射混进来）。

(
  (nil
   fromLib  "smic18ee"
   fromCell "n18e2r"
   toLib    "smic13mmrf_1233"
   toCell   "n33"
   runCallbacks t
   params (
     ("w" "w")
     ("l" "l")
     ("m" "m")
     )
   )

  (nil
   fromLib  "smic18ee"
   fromCell "p18e2r"
   toLib    "smic13mmrf_1233"
   toCell   "p33"
   runCallbacks t
   params (
     ("w" "w")
     ("l" "l")
     ("m" "m")
     )
   )
)